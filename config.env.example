# Wspolne ustawienia (LOG_CHANNEL_ID pozostaje kanalem dla Las Sosnowy).
DISCORD_TOKEN=uzupelnij_token_bota
ALLOWED_CHANNEL_IDS=
LOG_CHANNEL_ID=1035112319065268275

# Status Twitch jest wspolny, bo status Discorda jest wspolny dla jednego konta bota.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CHANNEL=505na
TWITCH_POLL_INTERVAL=180

# Ustawienia serwera 1 - zamien przykladowe ID na prawdziwe ID Discorda.
GUILD_111111111111111111_ALLOWED_CHANNEL_IDS=
GUILD_111111111111111111_LOG_CHANNEL_ID=

# Ustawienia serwera 2.
GUILD_222222222222222222_ALLOWED_CHANNEL_IDS=
GUILD_222222222222222222_LOG_CHANNEL_ID=

# Ustawienia GUILD_<ID>_ALLOWED_CHANNEL_IDS i LOG_CHANNEL_ID nadpisuja wspolne.
# Ustawienie ALLOWED_CHANNEL_IDS=all zezwala na komendy na wszystkich kanalach tego serwera.
GUILD_1526655387804111068_ALLOWED_CHANNEL_IDS=all
GUILD_1526655387804111068_LOG_CHANNEL_ID=1558212722427170948
