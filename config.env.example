# Wspolne dla obu serwerow
DISCORD_TOKEN=uzupelnij_token_bota
OWNER_ID=
BETA_TESTER_ROLE_ID=
ALLOWED_CHANNEL_IDS=

# Status Twitch jest wspolny, bo status Discorda jest wspolny dla jednego konta bota.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CHANNEL=505na
TWITCH_POLL_INTERVAL=180

# Ustawienia serwera 1 - zamien przykladowe ID na prawdziwe ID Discorda.
GUILD_111111111111111111_OWNER_ID=
GUILD_111111111111111111_BETA_TESTER_ROLE_ID=
GUILD_111111111111111111_ALLOWED_CHANNEL_IDS=
GUILD_111111111111111111_LOG_CHANNEL_ID=
GUILD_111111111111111111_BETA_MODE_ENABLED=true

# Ustawienia serwera 2.
GUILD_222222222222222222_OWNER_ID=
GUILD_222222222222222222_BETA_TESTER_ROLE_ID=
GUILD_222222222222222222_ALLOWED_CHANNEL_IDS=
GUILD_222222222222222222_LOG_CHANNEL_ID=
GUILD_222222222222222222_BETA_MODE_ENABLED=true

# Ustawienia GUILD_<ID>_* nadpisuja odpowiednie wspolne ustawienia.
